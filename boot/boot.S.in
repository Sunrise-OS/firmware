//! The stage-1 reset trampoline at flash offset zero, needed because QEMU's
//! `-bios` begins executing at the image base instead of discovering an EFI
//! firmware volume. The actual PI firmware volume lives after the RAM-linked
//! firmware in flash; this code only copies it into RAM for the firmware.
//!
//! The firmware itself is linked for RAM. Until it has copied the firmware to
//! its link address, cleared ELF zero-init ranges and branched to its entry
//! point, the trampoline may use neither a stack nor absolute addressing.
//! `mkimage` substitutes the addresses and lengths below; literal pools and
//! the zero-init range table remain PC-relative inside this same section.

.arch armv8-a
.section .text.boot, "ax"
.global _start

/* The stub is the first 4 KiB of the image; the firmware begins after it. */
.set    FLASH_OFFSET,  @FLASH_OFFSET@
.set    LOAD_ADDR,     @LOAD_ADDR@
.set    FIRMWARE_SIZE, @FIRMWARE_SIZE@
.set    ENTRY_ADDR,    @ENTRY_ADDR@
.set    ZERO_RANGE_COUNT, @ZERO_RANGE_COUNT@
.set    FV_OFFSET,      @FV_OFFSET@
.set    FV_SIZE,        @FV_SIZE@
.set    FV_ADDR,        @FV_ADDR@

_start:
    /* No interrupts or exceptions: there is no vector table yet. */
    msr     daifset, #0xf

    /* The boot protocol's argument is in x0 - the machine's device tree - and
       the firmware expects to find it there. The registers below are all the
       stub has, so it waits in a callee-saved one. */
    mov     x19, x0

    /* Copy the firmware from flash to its link address, a byte at a time: the
       MMU is off, so every address is Device-nGnRnE and an unaligned or
       multi-register access would fault. The two regions do not overlap, so a
       forward copy needs no cache maintenance. */
    ldr     x0, =FLASH_OFFSET
    ldr     x1, =LOAD_ADDR
    ldr     x2, =FIRMWARE_SIZE
1:
    cbz     x2, 2f
    ldrb    w3, [x0], #1
    strb    w3, [x1], #1
    sub     x2, x2, #1
    b       1b
2:
    /* Clear the ranges the image does not carry: `.bss`, and the tail of any
       segment whose size on disk is smaller than its size in memory. They are
       not in the copied bytes, and the firmware's statics need them zero. */
    adr     x4, zero_ranges
    ldr     x5, =ZERO_RANGE_COUNT
    cbz     x5, 8f
3:
    ldr     x1, [x4], #8
    ldr     x2, [x4], #8
4:
    cmp     x1, x2
    b.hs    5f
    strb    wzr, [x1], #1
    b       4b
5:
    subs    x5, x5, #1
    b.ne    3b

8:
    /* Copy the complete PI firmware volume from flash to scratch RAM. At reset
       the MMU is off: keep the byte-wise accesses required for Device memory.
       The firmware parses this copy and publishes it through an FV HOB. */
    ldr     x0, =FV_OFFSET
    ldr     x1, =FV_ADDR
    ldr     x2, =FV_SIZE
6:
    cbz     x2, 7f
    ldrb    w3, [x0], #1
    strb    w3, [x1], #1
    sub     x2, x2, #1
    b       6b
7:

    /* Enter the RAM-linked firmware with the device tree in x0 and the FV's
       RAM base and complete length in x1/x2. */
    mov     x0, x19
    ldr     x1, =FV_ADDR
    ldr     x2, =FV_SIZE
    ldr     x4, =ENTRY_ADDR
    br      x4

/* The zero-init ranges, as (start, end) pairs, generated by mkimage. The stub
   reaches this table with `adr`, so it must stay in the section the code is in:
   that is the section mkimage extracts, and its link address is not the address
   the stub runs it from. */
.align 3
zero_ranges:
@ZERO_RANGES@
